// ============================================================
// [WIFI ADDED] WI-FI + WEBSITE LINK + SCAN UPLOAD (VERCEL)
// ------------------------------------------------------------
// Status messages go to the Serial Monitor; the LCD shows the
// link screen (code) and the Scan now button feedback.
// ============================================================

// ---- EDIT THESE 3 THINGS -----------------------------------

const char* WIFI_SSID     = "akoaypogi";        // 2.4 GHz network only
const char* WIFI_PASSWORD = "12345678";

// Your Vercel URL + /api/esp32  (must start with https://)
const char* SERVER_URL    = "https://bocaue.vercel.app/api/esp32";

// NOTE: there is no username / DEVICE_ID any more. Whoever links the
// device on the website (6-character code) receives the scans.

// ---- OPTIONAL ----------------------------------------------

// Leave "" for first test. If you later set ESP32_API_KEY in Vercel,
// put the same value here.
const char* API_KEY       = "";

// While the code is on screen, ask the website this often (ms)
const unsigned long LINK_POLL_MS = 4000;

// -------------------------------------------------------------

unsigned long lastWifiRetry   = 0;
bool          wifiWasUp       = false;

String        deviceToken     = "";   // secret ID, generated once, kept in flash
String        linkedUser      = "";   // website account that owns the device now
String        pairCode        = "";   // code currently drawn on the LCD ("" = not shown)
String        lastMsgKey      = "";   // avoids redrawing the same message screen
String        msgL1, msgL2, msgL3;    // [LCD FIX] last message text (to redraw after an LCD reset)
unsigned long lastLinkPoll    = 0;
unsigned long linkingSince    = 0;
int           lastUploadCode  = 0;
int           pairPanelX      = 0;    // text panel of the code screen
int           pairPanelW      = 0;


void wifiBegin() {

  WiFi.mode(WIFI_STA);
  WiFi.setAutoReconnect(true);
  WiFi.begin(WIFI_SSID, WIFI_PASSWORD);   // does NOT block
  applyWifiTxPower();                     // [LCD FIX]

  Serial.print("[WIFI] Connecting to ");
  Serial.println(WIFI_SSID);
}


void wifiWatch() {

  bool up = (WiFi.status() == WL_CONNECTED);

  if (up && !wifiWasUp) {
    Serial.print("[WIFI] Connected. IP: ");
    Serial.print(WiFi.localIP());
    Serial.print("  RSSI: ");
    Serial.print(WiFi.RSSI());
    Serial.println(" dBm");
  }

  if (!up && wifiWasUp) {
    Serial.println("[WIFI] Connection lost, retrying...");
  }

  wifiWasUp = up;

  if (!up && millis() - lastWifiRetry > 10000) {
    lastWifiRetry = millis();
    Serial.println("[WIFI] Not connected - retrying (check name/password, 2.4GHz)");
    WiFi.disconnect();
    WiFi.begin(WIFI_SSID, WIFI_PASSWORD);
    applyWifiTxPower();   // [LCD FIX]
  }
}


// ------------------------------------------------------------
// Device secret: 32 random hex characters, created on first boot
// and kept in flash (survives reboots and re-flashing the sketch,
// unless you choose "Erase All Flash" in the Arduino IDE).
// ------------------------------------------------------------

void loadOrCreateToken() {

  Preferences prefs;

  prefs.begin("soilsense", false);

  deviceToken = prefs.getString("token", "");

  if (deviceToken.length() != 32) {

    char buf[33];

    for (int i = 0; i < 4; i++) {
      snprintf(buf + i * 8, 9, "%08lx", (unsigned long)esp_random());
    }

    deviceToken = String(buf);

    prefs.putString("token", deviceToken);

    Serial.println("[LINK] Created a new device ID");
  }

  prefs.end();
}


// "https://x.vercel.app/api/esp32"  ->  "https://x.vercel.app" + path
String apiUrl(const char* path) {

  String base = SERVER_URL;

  int i = base.indexOf("/api/");

  if (i >= 0) base = base.substring(0, i);

  return base + path;
}


// One tiny HTTP helper used for linking AND for uploading scans.
// Returns the HTTP status code (negative = could not connect).
int httpPost(const String &url, const char* body, String &reply, uint32_t timeoutMs) {

  bool useHttps = url.startsWith("https://");

  WiFiClientSecure secureClient;
  WiFiClient       plainClient;
  HTTPClient       http;

  bool began;

  if (useHttps) {
    secureClient.setInsecure();   // skips certificate check (OK for testing)
    began = http.begin(secureClient, url);
  } else {
    began = http.begin(plainClient, url);
  }

  if (!began) {
    reply = "http.begin() failed";
    return -1;
  }

  // Vercel can take several seconds on a cold start
  http.setTimeout(timeoutMs);
  http.setFollowRedirects(HTTPC_STRICT_FOLLOW_REDIRECTS);
  http.addHeader("Content-Type", "application/json");
  http.addHeader("X-Device-Token", deviceToken);

  if (strlen(API_KEY) > 0) {
    http.addHeader("X-API-Key", API_KEY);
  }

  int code = http.POST((uint8_t*)body, strlen(body));

  if (code > 0) reply = http.getString();
  else          reply = http.errorToString(code);

  http.end();

  return code;
}


// Minimal JSON reader: finds  "key": value  and returns the value as text.
String jsonGet(const String &json, const char* key) {

  String k = String("\"") + key + "\"";

  int i = json.indexOf(k);
  if (i < 0) return "";

  i = json.indexOf(':', i + k.length());
  if (i < 0) return "";

  i++;
  while (i < (int)json.length() && (json[i] == ' ' || json[i] == '\n')) i++;

  if (i >= (int)json.length()) return "";

  if (json[i] == '"') {
    int e = json.indexOf('"', i + 1);
    return (e < 0) ? String("") : json.substring(i + 1, e);
  }

  int e = i;
  while (e < (int)json.length() && json[e] != ',' && json[e] != '}' && json[e] != ' ' && json[e] != '\n') e++;

  return json.substring(i, e);
}



// ============================================================
// [OFFLINE ADDED] NO WI-FI?  SAVE SCANS ON THE ESP32-S3, UPLOAD LATER
//
//  * At start-up, if no Wi-Fi (or no server) is found, the LCD asks
//    "Continue offline?".  Yes = main screens open, Scan now works.
//  * Every scan taken without Wi-Fi is stored in flash (survives
//    power-off) - up to OFFLINE_MAX_SCANS, oldest dropped when full.
//  * As soon as Wi-Fi + server are reachable, stored scans are sent
//    one by one, oldest first.  A scan is deleted from the device
//    ONLY after the server answered "200 OK".
//  * If the device was never linked, the code screen appears when
//    Wi-Fi returns; after linking, the saved scans go to that account.
// ============================================================

#define OFFLINE_MAX_SCANS       80
#define OFFLINE_PROMPT_AFTER_MS 12000   // no Wi-Fi for this long -> ask
#define OFFLINE_ASK_AGAIN_MS    60000   // after "Keep trying", ask again later
#define OFFLINE_SYNC_GAP_MS      1500   // pause between two uploads

struct OfflineScan {
  uint16_t n, p, k;
  float    ph, temp, hum;
  float    oddErr;     // probe-check error
  uint8_t  cropIdx;    // crop #1  (255 = none)
  uint8_t  confPct;
  uint8_t  crop2Idx, crop3Idx, conf2, conf3;
  uint8_t  odd;        // 1 = probe check said "odd value"
  uint16_t advice;     // advisor bit mask
  uint32_t bootId;     // which power-on the scan belongs to
  uint32_t tSec;       // seconds since that power-on
};

OfflineScan   offlineQ[OFFLINE_MAX_SCANS];
int           offlineCount     = 0;
uint32_t      bootId           = 0;
String        savedOwner       = "";     // last account this device was linked to
bool          offlinePromptOn  = false;
unsigned long offlineAskAfter  = 0;
int           serverFailCount  = 0;
unsigned long lastSyncTry      = 0;
unsigned long syncBackoffUntil = 0;
bool          syncedSomething  = false;

int offlineCountPending() { return offlineCount; }


// Copy the reading + TinyML results that are on screen into a record
void snapshotScan(OfflineScan &o) {
  o.n = nitrogen;  o.p = phosphorus;  o.k = potassium;
  o.ph = soilPH;   o.temp = soilTemperature;  o.hum = soilHumidity;
  o.oddErr   = tinyErr;
  o.cropIdx  = (tinyTop[0] >= 0) ? (uint8_t)tinyTop[0] : 255;
  o.confPct  = tinyPct[0];
  o.crop2Idx = (tinyTop[1] >= 0) ? (uint8_t)tinyTop[1] : 255;
  o.conf2    = tinyPct[1];
  o.crop3Idx = (tinyTop[2] >= 0) ? (uint8_t)tinyTop[2] : 255;
  o.conf3    = tinyPct[2];
  o.odd      = tinyOdd ? 1 : 0;
  o.advice   = tinyAdvice;
  o.bootId   = bootId;
  o.tSec     = millis() / 1000;
}

// JSON body shared by live uploads and saved (offline) uploads
int buildScanJson(char *dst, size_t cap, const OfflineScan &o, bool offline, const char *ageField, const char *uid) {
  const char *c1 = (o.cropIdx  < TINYML_N_OUT) ? TINYML_CROPS[o.cropIdx]  : "";
  const char *c2 = (o.crop2Idx < TINYML_N_OUT) ? TINYML_CROPS[o.crop2Idx] : "";
  const char *c3 = (o.crop3Idx < TINYML_N_OUT) ? TINYML_CROPS[o.crop3Idx] : "";
  return snprintf(
    dst, cap,
    "{\"N\":%u,\"P\":%u,\"K\":%u,\"ph\":%.1f,\"temp\":%.1f,\"humidity\":%.1f,"
    "\"crop\":\"%s\",\"crop_conf\":%u,\"crop2\":\"%s\",\"crop2_conf\":%u,\"crop3\":\"%s\",\"crop3_conf\":%u,"
    "\"odd\":%u,\"odd_err\":%.3f,\"advice\":%u,\"offline\":%s,%s\"scan_uid\":\"%s\"}",
    (unsigned)o.n, (unsigned)o.p, (unsigned)o.k, o.ph, o.temp, o.hum,
    c1, (unsigned)o.confPct, c2, (unsigned)o.conf2, c3, (unsigned)o.conf3,
    (unsigned)o.odd, o.oddErr, (unsigned)o.advice, offline ? "true" : "false", ageField, uid
  );
}

void offlineSave() {
  Preferences prefs;
  prefs.begin("soilsense", false);
  if (offlineCount == 0) prefs.remove("queue2");
  else prefs.putBytes("queue2", offlineQ, offlineCount * sizeof(OfflineScan));
  prefs.end();
}


void offlineLoad() {
  Preferences prefs;
  prefs.begin("soilsense", false);

  prefs.remove("queue");                       // older firmware's format (no TinyML fields)

  size_t len = prefs.getBytesLength("queue2");
  if (len > 0 && len % sizeof(OfflineScan) == 0 && len <= sizeof(offlineQ)) {
    prefs.getBytes("queue2", offlineQ, len);
    offlineCount = len / sizeof(OfflineScan);
  } else {
    offlineCount = 0;
  }

  bootId = prefs.getUInt("bootid", 0) + 1;
  prefs.putUInt("bootid", bootId);

  savedOwner = prefs.getString("owner", "");
  prefs.end();

  Serial.print("[OFFLINE] Boot #");
  Serial.print(bootId);
  Serial.print(", saved scans waiting: ");
  Serial.println(offlineCount);
}


void rememberOwner(const String &user) {
  savedOwner = user;
  Preferences prefs;
  prefs.begin("soilsense", false);
  prefs.putString("owner", user);
  prefs.end();
}


void forgetOwner() {
  savedOwner = "";
  Preferences prefs;
  prefs.begin("soilsense", false);
  prefs.remove("owner");
  prefs.end();
}


// Store the reading that is on screen right now
void offlineAdd() {

  if (offlineCount >= OFFLINE_MAX_SCANS) {
    for (int i = 1; i < offlineCount; i++) offlineQ[i - 1] = offlineQ[i];
    offlineCount--;
    Serial.println("[OFFLINE] Storage full - oldest saved scan dropped");
  }

  snapshotScan(offlineQ[offlineCount++]);

  offlineSave();

  Serial.print("[OFFLINE] Scan saved on the ESP32-S3. Waiting for upload: ");
  Serial.println(offlineCount);
}


// ---- "Continue offline?" screen ------------------------------------------

