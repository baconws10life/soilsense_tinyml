void goPairing() {

  resetReadings();

  linkedUser     = "";
  pairCode       = "";
  lastMsgKey     = "";
  lastLinkPoll   = 0;
  linkingSince   = millis();

  scanBtnState   = BTN_IDLE;
  scanBtnResetAt = 0;

  appState       = APP_LINKING;

  Serial.println("[LINK] Waiting for a website user to link this device");
}


void enterReady(const String &user) {

  linkedUser = user;
  rememberOwner(user);          // [OFFLINE ADDED] so offline mode knows who this device belongs to
  serverFailCount = 0;

  Serial.print("[LINK] Linked to: ");
  Serial.println(user);

  String shown = user.substring(0, 24);

  showMessage("Linked!", "Signed in as " + shown, "Press Scan now to start");

  delay(1800);

  lastMsgKey     = "";
  pairCode       = "";
  scanBtnState   = BTN_IDLE;
  scanBtnResetAt = 0;
  appState       = APP_READY;
  currentScreen  = 0;

  drawScreen();
}


// Hold the logo for 1.5 s: release the device so someone else can link it
void switchUser() {

  Serial.println("[LINK] Switch user requested");

  if (WiFi.status() != WL_CONNECTED) {
    setScanBtn(BTN_NO_WIFI, 2500);
    return;
  }

  setScanBtn(BTN_SENDING, 0);

  String reply;

  int code = httpPost(apiUrl("/api/device/unlink"), "{}", reply, 15000);

  if (code == 200) {
    forgetOwner();
    goPairing();
  }
  else {
    setScanBtn(BTN_FAILED, 2500);
  }
}


// Runs from loop() while the device is not linked yet
void pairingTick() {

  // 0) [OFFLINE ADDED] no Wi-Fi / no internet for a while -> "Continue offline?"

  if (offlinePromptTick(WiFi.status() == WL_CONNECTED)) return;

  // 1) Wi-Fi

  if (WiFi.status() != WL_CONNECTED) {

    String hint = (millis() - linkingSince > 20000)
                    ? "Check name / password (2.4 GHz)"
                    : "Please wait...";

    showMessage("Connecting to Wi-Fi", String(WIFI_SSID), hint);

    return;
  }

  // 2) Device secret

  if (deviceToken.length() != 32) loadOrCreateToken();

  // 3) Ask the website for the current link code (or whether we are linked)

  if (lastLinkPoll != 0 && millis() - lastLinkPoll < LINK_POLL_MS) return;

  if (pairCode.length() == 0) {
    showMessage("Contacting server", "Getting your link code...", "");
  }

  String reply;

  int code = httpPost(apiUrl("/api/device/pair"), "{}", reply, 15000);

  lastLinkPoll = millis();

  if (code == 200) {

    serverFailCount = 0;

    if (jsonGet(reply, "paired") == "true") {
      enterReady(jsonGet(reply, "owner"));
      return;
    }

    String c = jsonGet(reply, "code");

    if (c.length() == 6) {

      if (c != pairCode) {
        Serial.print("[LINK] Link code: ");
        Serial.println(c);
        drawPairingScreen(c);
      }
      else {
        setPairStatus("Waiting for you to link...");
      }
    }
    else {
      Serial.println("[LINK] Unexpected server reply:");
      Serial.println(reply);
    }
  }
  else {

    if (code <= 0) serverFailCount++;     // [OFFLINE ADDED] counts "cannot reach server"

    Serial.print("[LINK] Server problem, HTTP ");
    Serial.println(code);
    Serial.println(reply);

    if (pairCode.length() > 0) {
      setPairStatus(code > 0 ? "Server error " + String(code) : String("No server reply"));
    }
    else {
      showMessage(
        code > 0 ? "Server error " + String(code) : String("Cannot reach server"),
        "Check SERVER_URL in the sketch",
        "Retrying..."
      );
    }
  }
}


// Runs from loop() once linked: returns the button to "Scan now" after feedback
void scanButtonTick() {

  if (scanBtnResetAt != 0 && millis() > scanBtnResetAt) {

    scanBtnResetAt = 0;

    setScanBtn(BTN_IDLE, 0);
  }
}



// ============================================================
// [LCD FIX] LCD WATCHDOG + BOOT DIAGNOSTICS
// ============================================================

// ILI9341 registers that can be READ back (needs the MISO wire, GPIO 13)
#define LCD_REG_RDMODE   0x0A   // display power mode: 0x9C = on and healthy
#define LCD_REG_RDMADCTL 0x0B   // orientation (changes after setRotation)

bool          lcdWatchdogOn = false;
uint8_t       lcdExpectPM   = 0;
uint8_t       lcdExpectMAD  = 0;
uint8_t       lcdBadChecks  = 0;
unsigned long lcdLastCheck  = 0;
unsigned long lcdLastFix    = 0;
unsigned int  lcdFixCount   = 0;
bool          bootDiagShown = false;


// Redraw whatever screen should currently be visible
void lcdRedrawCurrent() {

  if (appState == APP_LINKING) {

    if (offlinePromptOn) {
      drawOfflinePrompt();
    }
    else if (pairCode.length() > 0) {

      String c = pairCode;           // copy: drawPairingScreen() overwrites pairCode

      drawPairingScreen(c);
    }
    else if (lastMsgKey.length() > 0) {

      String a = msgL1;
      String b = msgL2;
      String c = msgL3;

      lastMsgKey = "";               // force showMessage() to really redraw

      showMessage(a, b, c);
    }
    else {

      tft.fillScreen(COL_BG);
    }
  }
  else {

    drawScreen();
  }
}


// Learn what a healthy panel reports. Only arms itself if the reading is
// exactly the normal value AND is stable - so a missing/floating MISO wire
// can never cause false alarms (the watchdog simply stays off).
void lcdArmWatchdog() {

  lcdWatchdogOn = false;

  uint8_t pm  = tft.readcommand8(LCD_REG_RDMODE);
  uint8_t mad = tft.readcommand8(LCD_REG_RDMADCTL);

  bool stable = (pm == 0x9C);

  for (int i = 0; i < 3; i++) {

    delay(5);

    if (
      tft.readcommand8(LCD_REG_RDMODE)   != pm ||
      tft.readcommand8(LCD_REG_RDMADCTL) != mad
    ) {
      stable = false;
    }
  }

  Serial.print("[LCD] power mode 0x");
  Serial.print(pm, HEX);
  Serial.print("  madctl 0x");
  Serial.println(mad, HEX);

  if (stable) {

    lcdExpectPM   = pm;
    lcdExpectMAD  = mad;
    lcdWatchdogOn = true;

    Serial.println("[LCD] watchdog ARMED");
  }
  else {

    Serial.println("[LCD] watchdog OFF (cannot read the panel back - check the SDO/MISO wire)");
  }
}


// Called from loop(): every 1.5 s ask the panel how it is doing.
// If it lost its settings twice in a row, re-initialise it and redraw.
void lcdWatchdogTick() {

  if (!lcdWatchdogOn) return;

  if (millis() - lcdLastCheck < 1500) return;

  lcdLastCheck = millis();

  uint8_t pm  = tft.readcommand8(LCD_REG_RDMODE);
  uint8_t mad = tft.readcommand8(LCD_REG_RDMADCTL);

  if (pm == lcdExpectPM && mad == lcdExpectMAD) {

    lcdBadChecks = 0;

    return;
  }

  lcdBadChecks++;

  if (lcdBadChecks < 2) return;          // one odd reading is not enough

  lcdBadChecks = 0;

  if (millis() - lcdLastFix < 4000) return;   // never thrash

  lcdLastFix = millis();

  lcdFixCount++;

  Serial.print("[LCD] Panel lost its settings (power mode 0x");
  Serial.print(pm, HEX);
  Serial.print(", madctl 0x");
  Serial.print(mad, HEX);
  Serial.print(") - re-initialising. Count: ");
  Serial.println(lcdFixCount);

  tft.begin(TFT_SPI_HZ);

  tft.setRotation(1);

  tft.fillScreen(COL_BG);

  lcdRedrawCurrent();
}


// Plain-language reason for the last restart
void printResetReason() {

  Serial.print("[BOOT] Last restart reason: ");

  switch (esp_reset_reason()) {

    case ESP_RST_POWERON:   Serial.println("power switched on (normal)"); break;
    case ESP_RST_EXT:       Serial.println("reset button / EN pin"); break;
    case ESP_RST_SW:        Serial.println("software restart"); break;
    case ESP_RST_PANIC:     Serial.println("CRASH (exception) - send me the lines printed just before this"); break;
    case ESP_RST_INT_WDT:   Serial.println("interrupt watchdog (program hung)"); break;
    case ESP_RST_TASK_WDT:  Serial.println("task watchdog (program hung)"); break;
    case ESP_RST_WDT:       Serial.println("watchdog (program hung)"); break;
    case ESP_RST_BROWNOUT:  Serial.println("BROWNOUT - the 3.3 V supply dipped. Fix the power (see notes)"); break;
    case ESP_RST_DEEPSLEEP: Serial.println("deep sleep wake"); break;
    default:                Serial.println("other / unknown"); break;
  }
}


// USB serial often attaches after the board boots, so print the facts
// again a few seconds later where you can actually see them.
void bootDiagTick() {

  if (bootDiagShown || millis() < 5000) return;

  bootDiagShown = true;

  printResetReason();

  Serial.print("[BOOT] Free memory: ");
  Serial.print(ESP.getFreeHeap());
  Serial.println(" bytes");

  Serial.print("[LCD] watchdog: ");
  Serial.print(lcdWatchdogOn ? "armed" : "off");
  Serial.print(", repairs so far: ");
  Serial.print(lcdFixCount);
  Serial.print(", panel power-mode reads 0x");
  Serial.print(tft.readcommand8(LCD_REG_RDMODE), HEX);
  Serial.println("  (0x9C = healthy)");
}


// ============================================================
// SETUP
// ============================================================

void setup() {

  Serial.begin(
    115200
  );

  printResetReason();         // [LCD FIX] why did the board (re)start?

  offlineLoad();              // [OFFLINE ADDED] saved scans + last owner from flash


  delay(500);


  // TFT BACKLIGHT

  pinMode(
    TFT_LED,
    OUTPUT
  );

  digitalWrite(
    TFT_LED,
    HIGH
  );


  // SPI

  SPI.begin(
    TFT_SCK,
    TFT_MISO,
    TFT_MOSI,
    TFT_CS
  );


  // TFT

  tft.begin(TFT_SPI_HZ);      // [LCD FIX] slower, more reliable SPI clock

  tft.setRotation(
    1
  );

  tft.fillScreen(
    COL_BG
  );


  // BOOT

  drawBootScreen();


  // RS485

  Serial2.begin(
    4800,
    SERIAL_8N1,
    RX2_PIN,
    TX2_PIN
  );


  pinMode(
    RE_DE_PIN,
    OUTPUT
  );

  digitalWrite(
    RE_DE_PIN,
    LOW
  );


  // TOUCH

  initTouch();


  delay(1500);


  // [LCD FIX] Wi-Fi now starts AFTER the screen is up and stable, and the
  // LCD watchdog is armed first so it knows what a healthy panel looks like.

  lcdArmWatchdog();


  // [WIFI ADDED] start Wi-Fi (non-blocking)

  wifiBegin();


  // INITIAL VALUES

  fertilityScore = 0;

  fertilityGrade = 'D';

  recommendedCrop =
    "Waiting";

  cropTier =
    "Waiting";


  // [LINK ADDED] main screens stay hidden until a website user links the device.
  // The code screen is drawn from loop().

  goPairing();


  // SERIAL

  Serial.println();
  Serial.println(
    "================================"
  );

  Serial.println(
    "SOILSENSE AGRI SENSE"
  );

  Serial.println(
    "7-IN-1 NPK SOIL MONITOR"
  );

  Serial.println(
    "TFT + FT6336 TOUCH"
  );

  Serial.println(
    "LANDSCAPE 320x240"
  );

  Serial.println(
    "PARTIAL SCREEN UPDATE ENABLED"
  );

  Serial.println(
    "================================"
  );
}


// ============================================================
// LOOP
// ============================================================

void loop() {

  // Keeps Wi-Fi alive in every state (non-blocking)

  wifiWatch();


  // [LCD FIX] detect a reset / glitched panel and repair it

  lcdWatchdogTick();

  bootDiagTick();


  // ----------------------------------------------------------
  // [LINK ADDED] NOT LINKED YET: only the code screen runs
  // ----------------------------------------------------------

  if (appState == APP_LINKING) {

    pairingTick();

    delay(20);

    return;
  }


  // ----------------------------------------------------------
  // TOUCH  (navigation + "Scan now" + long-press logo)
  // ----------------------------------------------------------

  handleTouch();


  // ----------------------------------------------------------
  // SENSOR
  // [SCAN CHANGED] The sensor is no longer read every 3 s.
  // It is read once each time "Scan now" is pressed (doScan()).
  // ----------------------------------------------------------

  scanButtonTick();


  // [OFFLINE ADDED] header "OFF" tag follows the Wi-Fi state, saved scans upload by themselves

  static bool lastWifiShown = true;
  bool wifiNow = (WiFi.status() == WL_CONNECTED);
  if (wifiNow != lastWifiShown) {
    lastWifiShown = wifiNow;
    drawHeader();
  }

  offlineSyncTick();


  delay(20);
}
