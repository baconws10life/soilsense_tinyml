void printCentered(
  int16_t cx,
  int16_t y,
  const String &text,
  uint8_t size,
  uint16_t color
) {

  tft.setTextSize(size);

  int16_t x1;
  int16_t y1;

  uint16_t w;
  uint16_t h;

  tft.getTextBounds(
    text.c_str(),
    0,
    0,
    &x1,
    &y1,
    &w,
    &h
  );

  tft.setTextColor(color);

  tft.setCursor(
    cx - w / 2,
    y
  );

  tft.print(text);
}


// ============================================================
// STATUS COLOR
// ============================================================

uint16_t statusColor(int status) {

  if (status == 0)
    return COL_ACCENT;

  if (status == 1)
    return COL_AMBER;

  return COL_RED;
}


// ============================================================
// GRADE COLOR
// ============================================================

uint16_t gradeColor(float score) {

  if (score >= 65)
    return COL_ACCENT;

  if (score >= 45)
    return COL_AMBER;

  return COL_RED;
}


// ============================================================
// FERTILITY SCORE
// ============================================================

float calculateFertility() {

  int score = 0;

  if (
    nitrogen >= 40 &&
    nitrogen <= 120
  ) {
    score++;
  }

  if (
    phosphorus >= 40 &&
    phosphorus <= 120
  ) {
    score++;
  }

  if (
    potassium >= 40 &&
    potassium <= 120
  ) {
    score++;
  }

  if (
    soilPH >= 5.5 &&
    soilPH <= 7.5
  ) {
    score++;
  }

  if (
    soilTemperature >= 20 &&
    soilTemperature <= 35
  ) {
    score++;
  }

  if (
    soilHumidity >= 50 &&
    soilHumidity <= 90
  ) {
    score++;
  }

  // Same 6 checks as the website (calculate_fertility in app.py).
  // The prototype has no rainfall input, so there is no 7th point.
  return (score / 6.0) * 100.0;
}


// ============================================================
// FERTILITY GRADE
// ============================================================

char getGrade(float score) {

  if (score >= 85)
    return 'A';

  if (score >= 65)
    return 'B';

  if (score >= 45)
    return 'C';

  return 'D';
}


// ============================================================
// SENSOR STATUS
// ============================================================

int getPHStatus() {

  if (
    soilPH >= 6.0 &&
    soilPH <= 7.0
  )
    return 0;

  if (
    soilPH >= 5.5 &&
    soilPH <= 7.5
  )
    return 1;

  return 2;
}


int getHumidityStatus() {

  if (
    soilHumidity >= 50 &&
    soilHumidity <= 90
  )
    return 0;

  if (
    soilHumidity >= 40 &&
    soilHumidity <= 95
  )
    return 1;

  return 2;
}


int getTemperatureStatus() {

  if (
    soilTemperature >= 20 &&
    soilTemperature <= 35
  )
    return 0;

  if (
    soilTemperature >= 15 &&
    soilTemperature <= 40
  )
    return 1;

  return 2;
}


// Website presets (READING_RANGES in app.py):
//   N, P : optimal 40-120, watch 25-130
//   K    : optimal 40-120, watch 25-150
int getNPKStatus(uint16_t value, uint16_t watchMax) {

  if (
    value >= 40 &&
    value <= 120
  )
    return 0;

  if (
    value >= 25 &&
    value <= watchMax
  )
    return 1;

  return 2;
}


// ============================================================
// [SCAN ADDED] SCAN NOW BUTTON (top bar, x 118..228, y 3..25)
// ============================================================

void drawScanButton() {

  const int bx = 118;
  const int by = 3;
  const int bw = 110;
  const int bh = 22;

  uint16_t fill   = COL_ACCENT;
  uint16_t border = COL_ACCENT;
  uint16_t txt    = COL_BG;
  const char* label = "Scan now";

  if (scanBtnState == BTN_SCANNING) {
    fill = COL_AMBER;  border = COL_AMBER;  txt = COL_BG;  label = "Scanning...";
  }
  else if (scanBtnState == BTN_SENDING) {
    fill = COL_BLUE;   border = COL_BLUE;   txt = COL_BG;  label = "Sending...";
  }
  else if (scanBtnState == BTN_SENT) {
    fill = COL_ACCENT_DIM; border = COL_ACCENT; txt = COL_ACCENT; label = "Sent!";
  }
  else if (scanBtnState == BTN_FAILED) {
    fill = COL_BG_RAISED;  border = COL_RED;    txt = COL_RED;    label = "Send failed";
  }
  else if (scanBtnState == BTN_NO_SENSOR) {
    fill = COL_BG_RAISED;  border = COL_RED;    txt = COL_RED;    label = "No sensor";
  }
  else if (scanBtnState == BTN_NO_WIFI) {
    fill = COL_BG_RAISED;  border = COL_RED;    txt = COL_RED;    label = "No Wi-Fi";
  }
  else if (scanBtnState == BTN_SAVED) {
    fill = COL_BG_RAISED;  border = COL_AMBER;  txt = COL_AMBER;  label = "Saved offline";
  }
  else if (scanBtnState == BTN_SYNCING) {
    fill = COL_BLUE;       border = COL_BLUE;   txt = COL_BG;     label = "Syncing...";
  }

  // [OFFLINE ADDED] idle button shows how many scans are waiting for Wi-Fi
  char pendingLabel[24];
  if (scanBtnState == BTN_IDLE && offlineCountPending() > 0) {
    snprintf(pendingLabel, sizeof(pendingLabel), "Scan now (%d saved)", offlineCountPending());
    label = pendingLabel;
  }

  tft.fillRoundRect(bx, by, bw, bh, 6, fill);
  tft.drawRoundRect(bx, by, bw, bh, 6, border);

  printCentered(bx + bw / 2, by + 7, String(label), 1, txt);
}


// holdMs > 0 = show this state for a moment, then go back to "Scan now"
void setScanBtn(int state, unsigned long holdMs) {

  scanBtnState = state;

  scanBtnResetAt = holdMs ? millis() + holdMs : 0;

  drawScanButton();
}


