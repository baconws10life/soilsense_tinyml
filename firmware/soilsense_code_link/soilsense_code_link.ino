    tft.print("Sensor OK");
  else
    tft.print("No Sensor");

  // [SCAN ADDED]
  drawScanButton();
}


// ============================================================
// DRAW HEALTH RING
// ============================================================

void drawHealthRing(
  float score,
  char grade
) {

  int cx = 52;
  int cy = 92;

  int radius = 39;


  tft.drawCircle(
    cx,
    cy,
    radius,
    COL_PANEL_HI
  );

  tft.drawCircle(
    cx,
    cy,
    radius - 1,
    COL_PANEL_HI
  );


  float percentage =
    constrain(score, 0, 100) / 100.0;

  int segments =
    percentage * 36;


  for (
    int i = 0;
    i < segments;
    i++
  ) {

    float angle =
      (-90.0 + i * 10.0) *
      DEG_TO_RAD;

    int x =
      cx + cos(angle) * radius;

    int y =
      cy + sin(angle) * radius;

    tft.fillCircle(
      x,
      y,
      4,
      gradeColor(score)
    );
  }


  printCentered(
    cx,
    cy - 12,
    String((int)score),
    2,
    COL_TEXT
  );


  printCentered(
    cx,
    cy + 8,
    "/100",
    1,
    COL_MUTED
  );


  String gradeText =
    "Grade " +
    String(grade);

  printCentered(
    cx,
    cy + 54,
    gradeText,
    1,
    gradeColor(score)
  );


  printCentered(
    cx,
    cy + 70,
    "SOIL HEALTH",
    1,
    COL_MUTED
  );
}


