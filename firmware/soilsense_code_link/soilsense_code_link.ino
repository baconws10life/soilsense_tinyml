// ============================================================
// READ TOUCH
// ============================================================

bool readTouch(
  int &x,
  int &y
) {

  Wire.beginTransmission(
    FT6336_ADDR
  );

  Wire.write(0x02);

  if (
    Wire.endTransmission(false) != 0
  ) {

    return false;
  }


  if (
    Wire.requestFrom(
      FT6336_ADDR,
      5
    ) != 5
  ) {

    return false;
  }


  byte touchCount =
    Wire.read();

  byte xHigh =
    Wire.read();

  byte xLow =
    Wire.read();

  byte yHigh =
    Wire.read();

  byte yLow =
    Wire.read();


  if (
    touchCount == 0
  ) {

    return false;
  }


  int rawX =
    ((xHigh & 0x0F) << 8) |
    xLow;

  int rawY =
    ((yHigh & 0x0F) << 8) |
    yLow;


  // LANDSCAPE TRANSFORMATION

  x = rawY;

  y = 239 - rawX;


  x = constrain(
    x,
    0,
    319
  );

  y = constrain(
    y,
    0,
    239
  );


  return true;
}


// ============================================================
// HANDLE TOUCH
// ============================================================

void handleTouch() {

  bool touched =
    readTouch(
      touchX,
      touchY
    );


  if (
    touched &&
    !previousTouch
  ) {

    Serial.print(
      "Touch RAW/MAPPED -> X: "
    );

    Serial.print(
      touchX
    );

    Serial.print(
      "  Y: "
    );

    Serial.println(
      touchY
    );


    // [SCAN ADDED] SCAN NOW (top bar)

    if (
      touchY <= 30 &&
      touchX >= 105 &&
      touchX <= 240
    ) {

      Serial.println(
        "TOUCH: SCAN NOW"
      );

      doScan();
    }


    // SOIL

    else if (
      touchY >= 208 &&
      touchY <= 239 &&
      touchX >= 5 &&
      touchX < 105
    ) {

      Serial.println(
        "TOUCH: SOIL"
      );


      if (currentScreen != 1) {

        currentScreen = 1;

        drawScreen();
      }
    }


    // HOME

    else if (
      touchY >= 208 &&
      touchY <= 239 &&
      touchX >= 110 &&
      touchX < 210
    ) {

      Serial.println(
        "TOUCH: HOME"
      );


      if (currentScreen != 0) {

        currentScreen = 0;

        drawScreen();
      }
    }


    // NPK

    else if (
      touchY >= 208 &&
      touchY <= 239 &&
      touchX >= 215
    ) {

      Serial.println(
        "TOUCH: NPK"
      );


      if (currentScreen != 2) {

        currentScreen = 2;

        drawScreen();
      }
    }

    else {

      Serial.println(
        "TOUCH: outside navigation"
      );
    }
  }


  // [LINK ADDED] hold the "SoilSense" logo for 1.5 s = switch user

  if (touched && !previousTouch) {

    touchStartMs = millis();

    longPressDone = false;
  }

  if (
    touched &&
    !longPressDone &&
    touchX < 100 &&
    touchY < HEADER_H &&
    millis() - touchStartMs > 1500
  ) {

    longPressDone = true;

    switchUser();
  }


  previousTouch =
    touched;
}


// ============================================================
// READ NPK SENSOR
// ============================================================

void readNPKSensor() {

  while (
    Serial2.available()
  ) {

    Serial2.read();
  }


  Serial.println();
  Serial.println(
    "Sending request..."
  );


  // TRANSMIT

  digitalWrite(
    RE_DE_PIN,
    HIGH
  );

  delay(5);


  Serial2.write(
    query,
    sizeof(query)
  );

  Serial2.flush();


  // RECEIVE

  digitalWrite(
    RE_DE_PIN,
    LOW
  );

  delay(5);


  int bytesRead = 0;

  unsigned long startTime =
    millis();


  while (
    millis() - startTime < 1500
  ) {

    if (
      Serial2.available()
    ) {

      if (
        bytesRead <
        sizeof(response)
      ) {

        response[bytesRead] =
          Serial2.read();

        bytesRead++;

      }

      else {

        Serial2.read();
      }
    }
  }


  // RAW RESPONSE

  Serial.print(
    "Bytes Read: "
  );

  Serial.println(
    bytesRead
  );


  Serial.print(
    "Raw Response: "
  );


  for (
    int i = 0;
    i < bytesRead;
    i++
  ) {

    Serial.print(
      "0x"
    );

    if (
      response[i] < 0x10
    ) {

      Serial.print(
        "0"
      );
    }

    Serial.print(
      response[i],
      HEX
    );

    Serial.print(
      " "
    );
  }


  Serial.println();


  // FIND VALID MODBUS FRAME

  int startIndex = -1;


  for (
    int i = 0;
    i < bytesRead - 2;
    i++
  ) {

    if (
      response[i] == 0x01 &&
      response[i + 1] == 0x03 &&
      response[i + 2] == 0x0E
    ) {

      startIndex = i;

      break;
    }
  }


  // VALID FRAME

  if (
    startIndex >= 0 &&
    bytesRead - startIndex >= 19
  ) {

    Serial.println(
      "VALID SENSOR FRAME FOUND!"
    );


    uint16_t humidityRaw =
      ((uint16_t)
      response[startIndex + 3] << 8) |
      response[startIndex + 4];


    uint16_t temperatureRaw =
      ((uint16_t)
      response[startIndex + 5] << 8) |
      response[startIndex + 6];


    soilConductivity =
      ((uint16_t)
      response[startIndex + 7] << 8) |
      response[startIndex + 8];


    uint16_t phRaw =
      ((uint16_t)
      response[startIndex + 9] << 8) |
      response[startIndex + 10];


    nitrogen =
      ((uint16_t)
      response[startIndex + 11] << 8) |
      response[startIndex + 12];


    phosphorus =
      ((uint16_t)
      response[startIndex + 13] << 8) |
      response[startIndex + 14];


    potassium =
      ((uint16_t)
      response[startIndex + 15] << 8) |
      response[startIndex + 16];


    // CONVERT

    soilHumidity =
      humidityRaw / 10.0;

    soilTemperature =
      temperatureRaw / 10.0;

    soilPH =
      phRaw / 10.0;


    sensorOK = true;


    // FERTILITY

    fertilityScore =
      calculateFertility();

    fertilityGrade =
      getGrade(
        fertilityScore
      );


    // [TINYML] three small neural networks run ON the ESP32-S3 (no Wi-Fi needed)

    {
      // 1) crop recommender -> top 3 crops
      tinymlTop3(
        (float)nitrogen, (float)phosphorus, (float)potassium,
        soilTemperature, soilHumidity, soilPH,
        tinyTop, tinyPct
      );

      tinyCropIdx = tinyTop[0];
      tinyConfPct = tinyPct[0];

      recommendedCrop = TINYML_CROPS[tinyCropIdx];

      // same tier thresholds as the website: 85+ Excellent, 60+ Good, else Fair
      cropTier = (tinyConfPct >= 85) ? "Excellent" : (tinyConfPct >= 60) ? "Good" : "Fair";

      // 2) probe check -> does this look like real soil?
      tinyErr = tinymlProbeCheck(
        (float)nitrogen, (float)phosphorus, (float)potassium,
        soilTemperature, soilHumidity, soilPH,
        &tinyOdd
      );

      // 3) nutrient advisor -> what needs fixing
      tinyAdvice = tinymlAdvise(
        (float)nitrogen, (float)phosphorus, (float)potassium,
        soilTemperature, soilHumidity, soilPH
      );

      Serial.println();
      Serial.println("[TINYML] ---- on-device analysis ----");
      for (int r = 0; r < 3; r++) {
        Serial.print("[TINYML] Crop #"); Serial.print(r + 1); Serial.print(": ");
        Serial.print(TINYML_CROPS[tinyTop[r]]); Serial.print("  "); Serial.print(tinyPct[r]); Serial.println("%");
      }
      Serial.print("[TINYML] Probe check: ");
      Serial.print(tinyOdd ? "ODD VALUE - re-insert the probe and scan again" : "looks like real soil");
      Serial.print("  (error "); Serial.print(tinyErr, 3); Serial.println(")");
      Serial.print("[TINYML] Advisor: ");
      if (tinyAdvice == 0) Serial.println("nothing to fix");
      else {
        for (int k = 0; k < TINYML_N_ADV; k++) if (tinyAdvice & (1u << k)) { Serial.print(TINYML_ADVICE[k]); Serial.print("; "); }
        Serial.println();
      }
    }


    // SERIAL VALUES

    Serial.println();
    Serial.println(
      "===== SENSOR VALUES ====="
    );


    Serial.print(
      "Soil Humidity: "
    );

    Serial.print(
      soilHumidity
    );

    Serial.println(
      " %"
    );


    Serial.print(
      "Soil Temperature: "
    );

    Serial.print(
      soilTemperature
    );

    Serial.println(
      " C"
    );


    Serial.print(
      "Soil Conductivity: "
    );

    Serial.println(
      soilConductivity
    );


    Serial.print(
      "Soil pH: "
    );

    Serial.println(
      soilPH
    );


    Serial.print(
      "Nitrogen: "
    );

    Serial.print(
      nitrogen
    );

    Serial.println(
      " mg/kg"
    );


    Serial.print(
      "Phosphorus: "
    );

    Serial.print(
      phosphorus
    );

    Serial.println(
      " mg/kg"
    );


    Serial.print(
      "Potassium: "
    );

    Serial.print(
      potassium
    );

    Serial.println(
      " mg/kg"
    );


    Serial.print(
      "Health Score: "
    );

    Serial.print(
      fertilityScore
    );

    Serial.print(
      "/100 Grade "
    );

    Serial.println(
      fertilityGrade
    );
  }


  else {

    sensorOK = false;

    Serial.println(
      "NO VALID NPK FRAME FOUND!"
    );
  }
}


// ============================================================
// TOUCH INITIALIZATION
// ============================================================

void initTouch() {

  pinMode(
    CTP_RST,
    OUTPUT
  );


  digitalWrite(
    CTP_RST,
    LOW
  );

  delay(20);


  digitalWrite(
    CTP_RST,
    HIGH
  );

  delay(200);


  Wire.begin(
    CTP_SDA,
    CTP_SCL
  );


  Serial.println(
    "FT6336 touch initialized"
  );


  Wire.beginTransmission(
    FT6336_ADDR
  );


  if (
    Wire.endTransmission() == 0
  ) {

    Serial.println(
      "FT6336 detected!"
    );

  }

  else {

    Serial.println(
      "WARNING: FT6336 not detected!"
    );
  }
}


