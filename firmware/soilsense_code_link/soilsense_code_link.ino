// ============================================================
// [LCD FIX] SETTINGS FOR A STABLE SCREEN
// ------------------------------------------------------------
// The black / glitching screen appears when the Wi-Fi radio
// draws current in short bursts: the supply dips or the SPI
// wires pick up noise, the LCD controller resets itself and
// forgets its settings. Three protections are added:
//   1. slower SPI clock       (more noise margin on jumper wires)
//   2. lower Wi-Fi TX power   (smaller current bursts)
//   3. LCD watchdog           (detects a reset panel and re-initialises it)
// ============================================================

// Library default is 32 MHz. 10 MHz is plenty for this UI.
// If the screen is rock-solid you may try 16000000 again.
const uint32_t TFT_SPI_HZ = 10000000;

// Lower = smaller current bursts. 11 dBm is fine inside a room.
// Raise to WIFI_POWER_15dBm only if Wi-Fi does not connect.
const wifi_power_t WIFI_TX_POWER = WIFI_POWER_11dBm;

void applyWifiTxPower() {

  WiFi.setTxPower(WIFI_TX_POWER);
}


