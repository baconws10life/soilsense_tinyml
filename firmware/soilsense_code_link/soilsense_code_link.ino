void enterOfflineMode() {

  offlinePromptOn = false;

  Serial.println("[OFFLINE] Continuing without Wi-Fi");

  linkedUser = savedOwner.length() ? savedOwner : String("offline");

  showMessage("Offline mode", "Scans are saved on the device", "They upload when Wi-Fi returns");

  delay(1800);

  lastMsgKey     = "";
  pairCode       = "";
  scanBtnState   = BTN_IDLE;
  scanBtnResetAt = 0;
  appState       = APP_READY;
  currentScreen  = 0;

  drawScreen();
}


// Called from pairingTick(): decides when to ask, and handles the two buttons
bool offlinePromptTick(bool wifiUp) {

  if (offlinePromptOn && wifiUp && serverFailCount < 3) {
    offlinePromptOn = false;              // Wi-Fi came back by itself
    lastMsgKey = "";
    return false;
  }

  bool trouble = (!wifiUp && millis() - linkingSince > OFFLINE_PROMPT_AFTER_MS) ||
                 (wifiUp && serverFailCount >= 3);

  if (!offlinePromptOn) {
    if (trouble && millis() > offlineAskAfter) drawOfflinePrompt();
    return offlinePromptOn;
  }

  // prompt is showing: wait for a tap
  static bool wasTouched = false;
  int tx = 0, ty = 0;
  bool t = readTouch(tx, ty);

  if (t && !wasTouched) {
    if (ty >= 168 && ty <= 220 && tx >= 12 && tx <= 156) {
      wasTouched = t;
      enterOfflineMode();
      return true;
    }
    if (ty >= 168 && ty <= 220 && tx >= 164 && tx <= 308) {
      offlinePromptOn = false;
      offlineAskAfter = millis() + OFFLINE_ASK_AGAIN_MS;
      serverFailCount = 0;
      lastMsgKey      = "";
      linkingSince    = millis();
    }
  }
  wasTouched = t;

  return offlinePromptOn;
}


// ---- upload the saved scans once the website is reachable --------------------

void offlineSyncTick() {

  if (offlineCount == 0) {
    if (syncedSomething && scanBtnState == BTN_IDLE) {
      syncedSomething = false;
      setScanBtn(BTN_SENT, 2500);       // "Sent!" = everything synced
    }
    return;
  }

  if (WiFi.status() != WL_CONNECTED) return;
  if (millis() < syncBackoffUntil)   return;
  if (millis() - lastSyncTry < OFFLINE_SYNC_GAP_MS) return;
  if (scanBtnState == BTN_SCANNING || scanBtnState == BTN_SENDING) return;

  lastSyncTry = millis();

  if (deviceToken.length() != 32) loadOrCreateToken();

  OfflineScan &o = offlineQ[0];

  // age of the scan (only known if it was taken during this power-on)
  char ageField[32] = "";
  if (o.bootId == bootId) {
    unsigned long nowSec = millis() / 1000;
    snprintf(ageField, sizeof(ageField), "\"age_s\":%lu,", (nowSec >= o.tSec) ? (nowSec - o.tSec) : 0UL);
  }

  char uid[40];
  snprintf(uid, sizeof(uid), "%s-%lu-%lu", deviceToken.substring(0, 8).c_str(), (unsigned long)o.bootId, (unsigned long)o.tSec);

  char body[640];
  buildScanJson(body, sizeof(body), o, true, ageField, uid);

  setScanBtn(BTN_SYNCING, 0);

  String reply;
  int code = httpPost(String(SERVER_URL), body, reply, 20000);

  Serial.print("[OFFLINE] Upload of saved scan -> HTTP ");
  Serial.println(code);

  if (code == 200) {
    for (int i = 1; i < offlineCount; i++) offlineQ[i - 1] = offlineQ[i];
    offlineCount--;
    offlineSave();
    syncedSomething = true;
    syncBackoffUntil = 0;
    setScanBtn(BTN_IDLE, 0);
    drawScanButton();
  }
  else if (code == 403) {
    // not linked (yet) -> show the code screen; saved scans stay on the device
    Serial.println("[OFFLINE] Device not linked - show link code, scans are kept");
    forgetOwner();
    setScanBtn(BTN_IDLE, 0);
    goPairing();
  }
  else {
    setScanBtn(BTN_IDLE, 0);
    syncBackoffUntil = millis() + 15000;   // try again in 15 s, scans stay saved
  }
}


// ------------------------------------------------------------
// Send the current reading to the website (called by Scan now)
// ------------------------------------------------------------

bool sendToWebsite() {

  lastUploadCode = 0;

  if (WiFi.status() != WL_CONNECTED) {
    Serial.println("[UPLOAD] Skipped - no Wi-Fi");
    return false;
  }

  // [TINYML] top-3 crops, probe check and advisor result travel with the reading
  OfflineScan snap;
  snapshotScan(snap);

  char body[640];
  buildScanJson(body, sizeof(body), snap, false, "", "");

  Serial.println("[UPLOAD] Sending:");
  Serial.println(body);

  String reply;

  unsigned long t0 = millis();
  int code = httpPost(String(SERVER_URL), body, reply, 20000);
  unsigned long took = millis() - t0;

  lastUploadCode = code;

  Serial.print("[UPLOAD] HTTP code: ");
  Serial.print(code);
  Serial.print("  (");
  Serial.print(took);
  Serial.println(" ms)");

  if (reply.length() > 350) reply = reply.substring(0, 350) + "...";
  Serial.println("[UPLOAD] Server reply:");
  Serial.println(reply);

  bool ok = (code == 200);

  Serial.println(ok ? "[UPLOAD] SUCCESS - saved on website"
                    : "[UPLOAD] FAILED - see code/reply above");
  return ok;
}


// ------------------------------------------------------------
// SCAN NOW: read the NPK sensor once, show it, send it
// ------------------------------------------------------------

void refreshValues() {

  if (currentScreen == 0) {
    updateDashboardValues();
  }
  else if (currentScreen == 1) {
    updateSoilValues();
  }
  else if (currentScreen == 2) {
    updateNPKValues();
  }
}


void doScan() {

  Serial.println("[SCAN] Scan now pressed");

  setScanBtn(BTN_SCANNING, 0);

  readNPKSensor();

  hasScanned = true;

  drawHeader();          // refreshes the "Sensor OK / No Sensor" text
  refreshValues();       // refreshes the numbers on the current screen

  if (!sensorOK) {
    setScanBtn(BTN_NO_SENSOR, 2500);
    return;
  }

  // [OFFLINE] no Wi-Fi -> keep the scan on the ESP32-S3, upload it later
  if (WiFi.status() != WL_CONNECTED) {
    offlineAdd();
    setScanBtn(BTN_SAVED, 2500);
    return;
  }

  setScanBtn(BTN_SENDING, 0);

  if (sendToWebsite()) {
    setScanBtn(BTN_SENT, 2500);
  }
  else if (lastUploadCode == 403) {
    // The account unlinked this device on the website -> back to the code screen
    // (the scan is kept so it is not lost)
    Serial.println("[LINK] Device is no longer linked");
    offlineAdd();
    forgetOwner();
    goPairing();
  }
  else if (lastUploadCode <= 0 || lastUploadCode >= 500) {
    // Wi-Fi is on but the website could not be reached -> same as offline
    offlineAdd();
    setScanBtn(BTN_SAVED, 2500);
  }
  else {
    setScanBtn(BTN_FAILED, 2500);
  }
}


